{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asl:knowledge-v1",
  "title": "ASL local derived knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "claims",
    "conditions",
    "source_resource_keys",
    "verification",
    "created_at_ms"
  ],
  "properties": {
    "version": { "const": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/claim" }
    },
    "conditions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/concept" }
    },
    "source_resource_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    },
    "verification": { "const": "derived_unverified" },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "$defs": {
    "concept": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 65535 },
        { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "boolean" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "null" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "hash" },
            "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "agent" },
            "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "concept" },
            "value": { "$ref": "#/$defs/concept" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "concepts" },
            "value": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/concept" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": { "const": "quantity" },
            "value": { "type": "integer" },
            "unit": { "$ref": "#/$defs/concept" }
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "value", "evidence"],
      "properties": {
        "subject": { "$ref": "#/$defs/value" },
        "predicate": { "$ref": "#/$defs/concept" },
        "value": { "$ref": "#/$defs/value" },
        "evidence": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
